# Copy this file to .env and fill in the values you need.

# Port the server listens on
PORT=4000

# Optional: fixed JWT signing secret. If omitted, one is generated automatically
# on first run and stored in data/.jwt-secret (fine for a single server instance).
JWT_SECRET=

# Optional — only needed if you want contact-form messages emailed to you.
# Without these, messages are still saved and visible in the editor's Messages tab.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=
